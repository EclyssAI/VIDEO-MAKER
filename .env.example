# Copie para .env (NUNCA versionar o .env)
COOKIE_SECURE=1                 # 1 em produção (HTTPS)
BETA_SIGNUP=1                   # 1 = toda conta sem assinatura recebe o plano Beta (demonstração)
SIGNUP_INVITE_CODE=             # opcional: exige código de convite para criar conta
ANTHROPIC_API_KEY=              # opcional: liga títulos/tradução automáticos via Claude API
CAKTO_ENABLED=0                 # só ligar depois de validar o fluxo completo com o cliente
CAKTO_WEBHOOK_SECRET=
CAKTO_OFFER_CREATOR=            # offer.id do Creator na Cakto
CAKTO_OFFER_STUDIO=             # offer.id do Creator Studio
CAKTO_CHECKOUT_CREATOR=         # link de checkout
CAKTO_CHECKOUT_STUDIO=
PUBLIC_URL=https://beta.exemplo.com  # URL pública (usada pelo MCP: /mcp e metadados OAuth)
FORWARDED_ALLOW_IPS=127.0.0.1         # IP do proxy reverso confiável (X-Forwarded-For)
# Claude Live Agent
LIVE_CLAUDE_ENABLED=1                 # 0 desliga a análise mesmo com chave
LIVE_CLAUDE_MODEL=claude-opus-5-5
LIVE_CLAUDE_EFFORT=low
LIVE_MAX_SESSIONS=10                  # sessões simultâneas por processo de agente (ver capacidade medida)
LIVE_WHISPER_MODEL=base
MAX_USER_RENDERS=8
# Live Monitor (multi-transmissão) — valores medidos em docs/CAPACIDADE_E_CUSTOS.md
LIVE_CAPACITY_TOTAL=10                # sessões de monitoramento ativas no servidor inteiro (acima disso: 503 ao iniciar)
LIVE_TRANSCRIBE=events                # events = só blocos com pico de áudio + janelas de corte/IA; all = todo bloco
LIVE_WHISPER_WORKERS=2                # transcrições simultâneas por agente
LIVE_VISUAL_FULL_MAX=3                # com mais sessões que isso no mesmo agente, imagem medida só nos quadros-chave
# MCP e cadastro
MCP_RATE_READ=120                     # chamadas de leitura por minuto por token
MCP_RATE_WRITE=20                     # chamadas de controle/escrita por minuto por token
SIGNUP_PER_IP_HOUR=10                 # cadastros por IP por hora
