# Copie para .env (NUNCA versionar o .env)
COOKIE_SECURE=1                 # 1 em produção (HTTPS)
BETA_SIGNUP=1                   # 1 = toda conta sem assinatura recebe o plano Beta (demonstração)
SIGNUP_INVITE_CODE=             # opcional: exige código de convite para criar conta
ANTHROPIC_API_KEY=              # opcional: liga títulos/tradução automáticos via Claude API
CAKTO_ENABLED=0                 # só ligar depois de validar o fluxo completo com o cliente
CAKTO_WEBHOOK_SECRET=
CAKTO_OFFER_CREATOR=            # offer.id do Creator na Cakto
CAKTO_OFFER_STUDIO=             # offer.id do Creator Studio
CAKTO_CHECKOUT_CREATOR=         # link de checkout
CAKTO_CHECKOUT_STUDIO=
